          "breakfast": {
            "name": "Cheesy Spinach Scrambled Eggs with Avocado",
            "estimated_calories_kcal_per_person": 550,
            "ingredients": [
              "3 large eggs",
              "1 tbsp butter",
              "1 cup fresh spinach",
              "1/2 cup shredded cheddar cheese",
              "1/2 avocado"
            ],
            "prep_time": 10,
            "Recipe": [
              "Crack the eggs into a bowl and whisk thoroughly with a pinch of salt and pepper.",
              "Melt the butter in a skillet over medium heat.",
              "Add the fresh spinach and sauté until wilted, about 1 to 2 minutes.",
              "Pour in the whisked eggs and stir gently, scrambling until cooked to your preference.",
              "Sprinkle the shredded cheddar cheese over the eggs and stir until melted and combined.",
              "Transfer to a plate and serve alongside sliced fresh avocado."
            ]
          },
          "lunch": {
            "name": "Grilled Chicken Salad with Feta and Lemon Olive Oil Dressing",
            "estimated_calories_kcal_per_person": 700,
            "ingredients": [
              "1 chicken breast",
              "2 cups mixed salad greens",
              "2 tbsp olive oil",
              "1 tbsp lemon juice",
              "1 oz feta cheese"
            ],
            "prep_time": 15,
            "Recipe": [
              "Season the chicken breast with salt and pepper on both sides.",
              "Heat a grill pan over medium-high heat with a small amount of oil, then cook the chicken breast for 6 to 7 minutes per side until fully cooked and golden brown. Slice into strips.",
              "In a large bowl, toss the mixed salad greens with the olive oil and fresh lemon juice.",
              "Top the salad with the warm sliced grilled chicken and crumbled feta cheese.",
              "Toss gently and serve immediately."
            ]
          },
          "dinner": {
            "name": "Baked Salmon with Garlic Butter Asparagus",
            "estimated_calories_kcal_per_person": 850,
            "ingredients": [
              "1 salmon fillet",
              "1 bunch asparagus",
              "2 tbsp butter",
              "1 clove garlic, minced",
              "1 tbsp olive oil"
            ],
            "prep_time": 25,
            "Recipe": [
              "Preheat your oven to 400 degrees Fahrenheit (200 degrees Celsius).",
              "Place the salmon fillet and trimmed asparagus spears on a baking sheet lined with parchment paper.",
              "Drizzle the salmon and asparagus with olive oil, then season with salt and pepper.",
              "In a small microwave-safe bowl, melt the butter and mix in the minced garlic.",
              "Brush the garlic butter mixture evenly over the salmon fillet and asparagus.",
              "Bake in the preheated oven for 12 to 15 minutes until the salmon flakes easily with a fork and the asparagus is tender-crisp.",
              "Plate the salmon and asparagus together, drizzle any remaining pan juices on top, and serve warm."
            ]
          }
        }
      }
    ]
  },
